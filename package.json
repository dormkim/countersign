{
  "name": "countersign",
  "version": "0.1.0",
  "description": "A human-controlled commerce layer for AI shopping agents: a payment firewall before checkout and a dispute copilot after it, on PayPal.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server/main.js",
    "test": "vitest run",
    "eval": "tsx eval/run.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
