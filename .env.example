# Copy to .env and fill in. Every variable is optional: with none set, Countersign
# runs fully offline (simulated PayPal, demo catalog, rule-based policy parser).

# --- PayPal sandbox (switches the adapter from simulated to real sandbox) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Email of the sandbox BUSINESS account the REST app belongs to (invoicer for Invoicing v2).
PAYPAL_MERCHANT_EMAIL=
# Base URL PayPal sends the buyer back to after approval.
PUBLIC_BASE_URL=http://localhost:3000

# --- LLM (any one; leave empty for the offline rule-based mode) ---
LLM_PROVIDER=            # anthropic | deepseek | none
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# Cap on model calls per UTC day (public demo cost guard); past it the app uses its offline rules.
LLM_DAILY_CALLS=1500

# --- Channel3 product search (real products); empty = built-in demo catalog ---
CHANNEL3_API_KEY=

PORT=3000
